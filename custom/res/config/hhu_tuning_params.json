                { "name": "GPS1_MB_OFS_Z", "min": -3, "max": 3, "step": 0.001, "reboot": true },
                { "name": "INS_POS1_X", "min": -3, "max": 3, "step": 0.001, "reboot": true },
                { "name": "INS_POS1_Y", "min": -3, "max": 3, "step": 0.001, "reboot": true },
                { "name": "INS_POS1_Z", "min": -3, "max": 3, "step": 0.001, "reboot": true }
            ]
        },
        {
            "name": "调试",
            "params": [
                { "name": "VCU_DBG_HZ", "min": 0, "max": 10, "step": 1 },
                { "name": "VCU_ENABLE", "min": 0, "max": 1, "step": 1, "integer": true }
            ]
        }
    ]
}
