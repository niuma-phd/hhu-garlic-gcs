                { "name": "PSC_VEL_D", "min": 0, "max": 1, "step": 0.01 },
                { "name": "PSC_VEL_IMAX", "min": 0, "max": 2, "step": 0.05 }
            ]
        },
        {
            "name": "转向",
            "params": [
                { "name": "TURN_RADIUS", "min": 0.5, "max": 20, "step": 0.1 },
                { "name": "ATC_STR_ACC_MAX", "min": 0, "max": 200, "step": 0.5 },
                { "name": "ATC_STR_DEC_MAX", "min": 0, "max": 200, "step": 0.5 },
                { "name": "ATC_STR_RAT_MAX", "min": 1, "max": 180, "step": 1 },
                { "name": "ATC_TURN_MAX_G", "min": 0.05, "max": 1, "step": 0.01 },
