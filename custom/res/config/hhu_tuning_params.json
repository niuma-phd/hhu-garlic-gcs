                { "name": "CRASH_VEL_MIN", "min": 0.01, "max": 0.5, "step": 0.01 },
                { "name": "CRASH_THR_MIN", "min": 0, "max": 100, "step": 1 },
                { "name": "FS_CRASH_CHECK", "min": 0, "max": 2, "step": 1, "integer": true },
