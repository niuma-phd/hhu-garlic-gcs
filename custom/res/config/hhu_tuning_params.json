                { "name": "VCU_W_BASE", "min": 0.3, "max": 3, "step": 0.01 },
                { "name": "VCU_WORK_EN", "min": 0, "max": 1, "step": 1, "integer": true },
                { "name": "VCU_REV", "min": 0, "max": 1, "step": 1, "integer": true },
